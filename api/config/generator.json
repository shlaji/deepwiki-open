{
  "default_provider": "ollama",
  "providers": {
    "openai": {
      "default_model": "gpt-6-luna",
      "initialize_kwargs": {
        "api_key": "${OPENAI_API_KEY}",
        "base_url": "${OPENAI_BASE_URL}"
      },
      "supportsCustomModel": true,
      "models": {
        "gpt-6-luna": {
          "temperature": 1.0
        },
        "gpt-6-luna-fast": {
          "temperature": 1.0
        },
        "gpt-6.1-sol": {
          "temperature": 1.0
        }
      }
    },
    "ollama": {
      "default_model": "qwen3.6:35b",
      "supportsCustomModel": true,
      "models": {
        "qwen3.6:35b": {
          "options": {
            "temperature": 0.7,
            "top_p": 0.8,
            "num_ctx": 32000
          }
        },
        "qwen3:8b": {
          "options": {
            "temperature": 0.7,
            "top_p": 0.8,
            "num_ctx": 32000
          }
        }
      }
    },
    "litellm": {
      "default_model": "ollama",
      "supportsCustomModel": true,
      "models": {
        "minimax": {
          "temperature": 0.7,
          "top_p": 0.8
        },
        "ollama": {
          "temperature": 0.7,
          "top_p": 0.8
        }
      }
    }
  }
}
